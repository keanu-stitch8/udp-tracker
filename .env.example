# Neon Postgres (Vercel → Storage → Neon mengisi otomatis). Lokal: salin connection string Neon (branch dev).
DATABASE_URL=

# Hasil `npm run hash-password` — APP_PASSWORD_HASH berupa base64 (hash argon2 mengandung `$`, yang diekspansi oleh dotenv).
APP_PASSWORD_HASH=
SESSION_SECRET=

# Rencana 3 (bon): Vercel Blob + Gemini
BLOB_READ_WRITE_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=

# Rencana 4 (ekspor): OAuth client Google yang sama dengan mkk-dashboard
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=
ENCRYPTION_KEY=
