# Neon Postgres — diisi `neon env pull` / `neon deploy` (project di-link lewat neon.ts).
# DATABASE_URL = pooled (-pooler) untuk app; DATABASE_URL_UNPOOLED = direct untuk migrasi.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# Login Google. SESSION_SECRET acak ≥ 32 karakter: `openssl rand -base64 48`.
SESSION_SECRET=
# Email yang otomatis jadi Root saat login (dipisah koma). Juga jalur pemulihan bila Root terkunci.
ROOT_EMAILS=

# Rencana 3 (bon): Vercel Blob + Gemini
BLOB_READ_WRITE_TOKEN=
GEMINI_API_KEY=
# default gemini-flash-lite-latest (boleh beberapa, dipisah koma; berikutnya = cadangan saat sibuk/kuota habis)
GEMINI_MODEL=

# OAuth client Google untuk login + ekspor. Redirect URI: <origin>/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=
ENCRYPTION_KEY=
